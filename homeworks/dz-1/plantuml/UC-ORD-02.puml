@startuml
skinparam defaultFontName "DejaVu Sans"
skinparam BackgroundColor #FFFFFF
skinparam maxMessageSize 240
skinparam sequenceMessageAlign left
skinparam sequence {
  ArrowColor #2C3E50
  LifeLineBorderColor #95A5A6
  LifeLineBackgroundColor #F8F9F9
  ParticipantBorderColor #21618C
  ParticipantBackgroundColor #EAF2F8
  ParticipantFontColor #1B2631
  ActorBorderColor #196F3D
  ActorBackgroundColor #D5F5E3
  DatabaseBorderColor #B9770E
  DatabaseBackgroundColor #FCF3CF
  BoxBorderColor #D5D8DC
  GroupBorderColor #A569BD
  GroupBackgroundColor #F4ECF7
  GroupHeaderFontColor #6C3483
}
skinparam noteBackgroundColor #FEF9E7
skinparam noteBorderColor #B7950B
autonumber
title UC-ORD-02 «Оформить заказ по факсу» (специализация UC-ORD-01)
actor "Клиент" as Client
actor "Сотрудник\nкафе" as Staff
participant "web-app-staff" as StaffApp
participant "api-gateway" as GW
participant "menu-service" as MenuSvc
participant "orders-service" as OrdSvc
database "orders-db" as OrdDb
queue "kafka" as Kafka
participant "Система\nпроизводства" as Prod
 
Client -->> Staff: Отправить заказ по факсу (состав, контакты) [вне системы]
Staff -> StaffApp: Ввести заказ от имени клиента
StaffApp -> GW: Создать заказ [HTTPS REST]
GW -> MenuSvc: Проверить позиции по актуальному меню
MenuSvc --> GW: Позиции, цены
GW -> OrdSvc: Сформировать заказ
OrdSvc --> StaffApp: Отобразить сумму
 
alt A1. Уточнение по телефону (факс распознан частично)
  Staff -->> Client: Связаться и уточнить состав
end
group E2. Факс нечитаем
  Staff -->> Client: Запросить повторную отправку или уточнить по телефону
end
 
Staff -> StaffApp: Уточнить способ получения и оплаты
StaffApp -> GW: Зафиксировать параметры
GW -> OrdSvc: Создать заказ с уникальным номером
OrdSvc -> OrdDb: Сохранить заказ [JDBC]
 
== Передача в обработку (UC-ORD-06) ==
OrdSvc --> Kafka: produser.orders.state
Kafka --> Prod: consumer.orders.state (на приготовление)
OrdSvc --> GW: Номер заказа и время готовности
GW --> StaffApp: Данные заказа
Staff -->> Client: Сообщить номер заказа и время готовности
 
group E1. Позиция недоступна (шаг 3)
  OrdSvc --> StaffApp: Позиция запрещена; сотрудник согласует замену с клиентом
end
@enduml
